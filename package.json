    "test:all": "bun run test && bun run test:integration && bun run test:tui && bun run test:perf"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.34",
    "@opencode-ai/sdk": ">=1.14.34"
  },
